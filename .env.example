# Waseet AI Standalone Microservice ? Environment Template
NODE_ENV="development"
PORT="5010"
HOST="127.0.0.1"

# Core Backend Authentication & Token Signing
WASEET_AI_CLIENT_ID="waseet-internal-backend"
WASEET_AI_CLIENT_SECRET="replace-with-client-secret"
WASEET_AI_TOKEN_SIGNING_SECRET="replace-with-token-signing-secret"
WASEET_AI_ENVIRONMENT="dev"
WASEET_AI_ALLOWED_ORIGINS="http://localhost:4200,http://127.0.0.1:4200,http://localhost:5009"
WASEET_AI_STATE_DIR="./work/ai-state"

# 20-Project Isolated Gemini API Pool (Round-Robin Smart Router)
